{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-event.schema.json",
  "title": "AttemptEvent",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "occurred_at",
    "learner_id",
    "cycle_id",
    "practice_session_id",
    "question_id",
    "question_revision",
    "answer",
    "hints_used",
    "evaluation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^attempt\\." },
    "type": { "enum": ["attempt.recorded", "attempt.reevaluated"] },
    "supersedes": { "type": "string", "pattern": "^attempt\\." },
    "corrected_at": { "type": "string", "format": "date-time" },
    "correction_reason": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "learner_id": { "type": "string", "minLength": 1 },
    "cycle_id": { "type": "string", "pattern": "^cycle\\." },
    "practice_session_id": { "type": "string", "pattern": "^practice-session\\." },
    "question_id": { "type": "string", "pattern": "^q\\." },
    "question_revision": { "type": "integer", "minimum": 1 },
    "assistance": { "enum": ["independent", "hints", "reference_seen"] },
    "answer": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "hints_used": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "evaluation": {
      "type": "object",
      "required": ["scores", "missing_points", "feedback", "evaluator"],
      "properties": {
        "scores": {
          "type": "object",
          "required": ["recall", "correctness", "depth", "communication"],
          "properties": {
            "recall": { "type": "integer", "minimum": 0, "maximum": 4 },
            "correctness": { "type": "integer", "minimum": 0, "maximum": 4 },
            "depth": { "type": "integer", "minimum": 0, "maximum": 4 },
            "communication": { "type": "integer", "minimum": 0, "maximum": 4 }
          },
          "additionalProperties": false
        },
        "missing_points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "feedback": { "type": "string", "minLength": 1 },
        "improved_answer": { "type": "string" },
        "evaluator": {
          "type": "object",
          "required": ["agent"],
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "model": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": { "properties": { "type": { "const": "attempt.reevaluated" } } },
    "then": { "required": ["supersedes", "corrected_at", "correction_reason"] },
    "else": { "not": { "anyOf": [
      { "required": ["supersedes"] },
      { "required": ["corrected_at"] },
      { "required": ["correction_reason"] }
    ] } }
  }],
  "additionalProperties": false
}
