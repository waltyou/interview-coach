{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "Job",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "company",
    "role_title",
    "posting_url",
    "requisition_id",
    "target_level",
    "locations",
    "target_roles",
    "brief_path",
    "question_plan",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^job\\.[a-z0-9][a-z0-9.-]+$" },
    "status": { "enum": ["considering", "interviewing", "offer", "closed", "withdrawn"] },
    "company": { "type": "string", "minLength": 1 },
    "role_title": { "type": "string", "minLength": 1 },
    "posting_url": { "type": ["string", "null"] },
    "requisition_id": { "type": ["string", "null"] },
    "target_level": { "type": ["string", "null"] },
    "locations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "target_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "brief_path": { "type": "string", "minLength": 1 },
    "question_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "priority", "target_minutes", "rationale"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^q\\." },
          "priority": { "enum": ["must", "should", "stretch"] },
          "target_minutes": { "type": "integer", "minimum": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
