{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teaching-session.schema.json",
  "title": "TeachingSession",
  "type": "object",
  "required": ["schema_version", "id", "status", "goal", "gap", "evidence", "path", "current_step", "phase", "sources", "checks", "pending_check", "created_at", "updated_at", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^teaching-session\\.[A-Za-z0-9.-]+$"},
    "status": {"enum": ["active", "completed", "stopped"]},
    "goal": {"type": "string", "minLength": 1},
    "gap": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "path": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "current_step": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["probe", "teach", "transfer"]},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/check"}, {"required": ["answer", "feedback", "outcome", "answered_at"]}]}},
    "pending_check": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/check"}]},
    "cancelled_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "next_action": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "question": {"type": ["object", "null"]}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["prompt", "explanation", "assistance", "phase", "step", "created_at"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "explanation": {"type": "string"},
        "assistance": {"enum": ["independent", "hints", "reference_seen"]},
        "phase": {"enum": ["probe", "teach", "transfer"]},
        "step": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "answer": {"type": "string", "minLength": 1},
        "feedback": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["passed", "gap"]},
        "answered_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
